const CORE_SHELLS = {
  "He": [2],
  "Ne": [2, 8],
  "Ar": [2, 8, 8],
  "Kr": [2, 8, 18, 8],
  "Xe": [2, 8, 18, 18, 8],
  "Rn": [2, 8, 18, 32, 18, 8]
};

const NO_VALUE = "#ffffff";

function getPosition(el) {
  if (el.n >= 57 && el.n <= 71) {
    return { row: 9, col: el.n - 54 };
  }
  if (el.n >= 89 && el.n <= 103) {
    return { row: 10, col: el.n - 86 };
  }
  return { row: el.p, col: el.g };
}

function getBlock(el) {
  if ((el.n >= 57 && el.n <= 71) || (el.n >= 89 && el.n <= 103)) {
    return "f";
  }
  if (el.n === 2 || el.g <= 2) {
    return "s";
  }
  if (el.g <= 12) {
    return "d";
  }
  return "p";
}

function getEra(el) {
  if (el.y === "ancient") {
    return "ancient";
  }
  const year = parseInt(el.y, 10);
  if (year < 1800) {
    return "pre1800";
  }
  if (year < 1900) {
    return "1800s";
  }
  if (year < 1950) {
    return "early1900s";
  }
  return "modern";
}

function getShells(el) {
  let shells = [];
  const core = el.cfg.match(/\[(\w+)\]/);
  if (core) {
    shells = CORE_SHELLS[core[1]].slice();
  }
  const orbitals = el.cfg.match(/\d[spdf]\d+/g) || [];
  orbitals.forEach(function (orbital) {
    const level = parseInt(orbital.charAt(0), 10);
    const count = parseInt(orbital.slice(2), 10);
    while (shells.length < level) {
      shells.push(0);
    }
    shells[level - 1] += count;
  });
  return shells;
}

function getMassNumber(el) {
  if (el.m.charAt(0) === "[") {
    return parseInt(el.m.slice(1), 10);
  }
  return Math.round(parseFloat(el.m));
}

function densityValue(el) {
  if (el.d === null) {
    return null;
  }
  return el.ph === "gas" ? el.d / 1000 : el.d;
}

function meltingValue(el) {
  return el.mp;
}

function boilingValue(el) {
  return el.sub ? null : el.bp;
}

function isRadioactive(el) {
  if (el.n === 83) {
    return "Yes, extremely slowly (half-life far longer than the age of the universe)";
  }
  if (el.n === 43 || el.n === 61 || el.n >= 84) {
    return "Yes";
  }
  return "No";
}

function getOccurrence(el) {
  if (el.n > 94) {
    return "Synthetic only";
  }
  if (el.n === 43 || el.n === 61 || el.n === 85 || el.n === 87 || el.n === 93 || el.n === 94) {
    return "Trace amounts in nature";
  }
  return "Found in nature";
}

function round(value, digits) {
  return Number(value.toFixed(digits));
}

function ordinal(n) {
  const suffixes = ["th", "st", "nd", "rd"];
  const v = n % 100;
  return n + (suffixes[(v - 20) % 10] || suffixes[v] || suffixes[0]);
}

function rankOf(el, valueOf) {
  const value = valueOf(el);
  if (value === null) {
    return "Not ranked";
  }
  const values = ELEMENTS.map(valueOf).filter(function (v) { return v !== null; });
  const higher = values.filter(function (v) { return v > value; }).length;
  return ordinal(higher + 1) + " highest of " + values.length;
}

function scaleColor(value, min, max) {
  if (value === null) {
    return NO_VALUE;
  }
  const t = Math.max(0, Math.min(1, (value - min) / (max - min)));
  const lightness = Math.round(95 - t * 45);
  return "hsl(0, 0%, " + lightness + "%)";
}

function enGroup(en) {
  if (en === null) {
    return "none";
  }
  if (en < 1.5) {
    return "low";
  }
  if (en < 2.5) {
    return "mid";
  }
  return "high";
}

function densityGroup(el) {
  const d = densityValue(el);
  if (d === null) {
    return "none";
  }
  if (d < 5) {
    return "light";
  }
  if (d < 12) {
    return "medium";
  }
  return "heavy";
}

function meltingGroup(el) {
  if (el.mp === null) {
    return "none";
  }
  if (el.mp < 25) {
    return "below";
  }
  if (el.mp < 1000) {
    return "low";
  }
  if (el.mp < 2000) {
    return "mid";
  }
  return "high";
}

function legendFrom(table) {
  return Object.keys(table).map(function (key) {
    return { key: key, label: table[key].label, color: table[key].color };
  });
}


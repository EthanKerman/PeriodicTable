function formatConfig(cfg) {
  return cfg.replace(/([spdf])(\d+)/g, "$1<sup>$2</sup>");
}

function capitalize(text) {
  return text.charAt(0).toUpperCase() + text.slice(1);
}

function orUnknown(value, unit) {
  if (value === null || value === undefined) {
    return "Unknown";
  }
  return value + (unit ? " " + unit : "");
}

function formatTemp(celsius) {
  if (celsius === null) {
    return "Unknown";
  }
  const kelvin = round(celsius + 273.15, 2);
  const fahrenheit = round(celsius * 9 / 5 + 32, 1);
  return celsius + " &deg;C &middot; " + kelvin + " K &middot; " + fahrenheit + " &deg;F";
}

function formatDensity(el) {
  if (el.d === null) {
    return "Unknown";
  }
  return el.d + (el.ph === "gas" ? " g/L" : " g/cm&sup3;");
}

function formatLiquidRange(el) {
  if (el.sub || el.mp === null || el.bp === null) {
    return "Unknown";
  }
  return round(el.bp - el.mp, 2) + " &deg;C";
}

function getSelected() {
  return ELEMENTS.find(function (el) { return el.n === state.selected; }) || null;
}

function matchesSearch(el, query) {
  const q = query.toLowerCase().trim();
  if (q === "") {
    return true;
  }
  return el.name.toLowerCase().includes(q) || el.s.toLowerCase() === q || String(el.n) === q;
}

function addPlaceholder(row, col, text) {
  const box = document.createElement("div");
  box.className = "placeholder";
  box.style.gridRow = row;
  box.style.gridColumn = col;
  box.textContent = text;
  table.appendChild(box);
}

function buildTable() {
  ELEMENTS.forEach(function (el) {
    const pos = getPosition(el);
    const cell = document.createElement("div");
    cell.className = "cell";
    cell.style.gridRow = pos.row;
    cell.style.gridColumn = pos.col;
    cell.innerHTML =
      '<span class="num">' + el.n + '</span>' +
      '<span class="sym">' + el.s + '</span>' +
      '<span class="name">' + el.name + '</span>' +
      '<span class="mass">' + el.m + '</span>';
    cell.addEventListener("click", function () { selectElement(el.n); });
    cell.addEventListener("mouseenter", function () { showPreview(el); });
    cell.addEventListener("mouseleave", function () { showPreview(getSelected()); });
    table.appendChild(cell);
    cells.set(el.n, cell);
  });
  addPlaceholder(6, 3, "57-71");
  addPlaceholder(7, 3, "89-103");
}

function updateCells() {
  const mode = COLOR_MODES[state.mode];
  ELEMENTS.forEach(function (el) {
    const cell = cells.get(el.n);
    cell.style.background = mode.colorOf(el);
    const inSearch = matchesSearch(el, state.search);
    const inHighlight = state.highlight === null || mode.groupOf(el) === state.highlight;
    cell.classList.toggle("dim", !(inSearch && inHighlight));
    cell.classList.toggle("selected", el.n === state.selected);
  });
  renderLegend();
}

function renderLegend() {
  const mode = COLOR_MODES[state.mode];
  legend.innerHTML = "";
  mode.legend().forEach(function (item) {
    const chip = document.createElement("button");
    chip.className = "chip" + (state.highlight === item.key ? " active" : "");
    chip.innerHTML = '<span class="swatch" style="background:' + item.color + '"></span>' + item.label;
    chip.addEventListener("click", function () {
      state.highlight = state.highlight === item.key ? null : item.key;
      updateCells();
    });
    legend.appendChild(chip);
  });
}

function showPreview(el) {
  if (el === null) {
    preview.innerHTML = "";
    return;
  }
  const color = COLOR_MODES[state.mode].colorOf(el);
  preview.innerHTML =
    '<div class="preview-sym" style="background:' + color + '">' + el.s + '</div>' +
    '<div>' +
      '<div class="preview-name">' + el.name + '</div>' +
      '<div class="preview-meta">' + el.n + ' &middot; ' + el.m + ' u &middot; ' + CATEGORIES[el.c].label + '</div>' +
      '<div class="preview-meta">' + formatConfig(el.cfg) + '</div>' +
    '</div>';
}

function renderSection(title, rows) {
  return '<h3>' + title + '</h3>' +
    '<dl class="props">' +
      rows.map(function (row) {
        return '<div><dt>' + row[0] + '</dt><dd>' + row[1] + '</dd></div>';
      }).join("") +
    '</dl>';
}

function renderDetails() {
  const el = getSelected();
  if (el === null) {
    details.innerHTML = "";
    return;
  }

  const shells = getShells(el);
  const massNumber = getMassNumber(el);
  const predicted = el.n >= 109 ? " (predicted)" : "";

  const overview = [
    ["Atomic number", el.n],
    ["Symbol", el.s],
    ["Atomic mass", el.m + " u"],
    ["Category", CATEGORIES[el.c].label],
    ["Group", el.g === null ? "None (f-block)" : el.g],
    ["Period", el.p],
    ["Block", getBlock(el) + "-block"],
    ["Name origin", el.from]
  ];

  const structure = [
    ["Protons", el.n],
    ["Electrons", el.n],
    ["Neutrons (approx.)", massNumber - el.n],
    ["Mass number (approx.)", massNumber],
    ["Electron configuration", formatConfig(el.cfg) + predicted],
    ["Electrons per shell", shells.join(", ")],
    ["Number of shells", shells.length],
    ["Outer-shell electrons", shells[shells.length - 1]],
    ["Covalent radius", orUnknown(el.r, "pm")]
  ];

  const physical = [
    ["Phase at room temperature", capitalize(el.ph)],
    ["Melting point", el.sub ? "Sublimes at " + formatTemp(el.bp) : formatTemp(el.mp)],
    ["Boiling point", el.sub ? "Does not boil (sublimes)" : formatTemp(el.bp)],
    ["Liquid range", formatLiquidRange(el)],
    ["Density", formatDensity(el)]
  ];

  const chemical = [
    ["Electronegativity (Pauling)", el.en === null ? "Unknown" : el.en.toFixed(2)],
    ["First ionization energy", orUnknown(el.ie, "kJ/mol")],
    ["Electron affinity", orUnknown(el.ea, "kJ/mol")],
    ["Common oxidation states", orUnknown(el.ox)]
  ];

  const nuclear = [
    ["Radioactive", isRadioactive(el)],
    ["Occurrence", getOccurrence(el)]
  ];

  const history = [
    ["Discovered", el.y === "ancient" ? "Known since ancient times" : el.y],
    ["Discovered by", el.by]
  ];

  const rankings = [
    ["Density", rankOf(el, densityValue)],
    ["Melting point", rankOf(el, meltingValue)],
    ["Boiling point", rankOf(el, boilingValue)],
    ["Electronegativity", rankOf(el, function (e) { return e.en; })],
    ["First ionization energy", rankOf(el, function (e) { return e.ie; })],
    ["Electron affinity", rankOf(el, function (e) { return e.ea; })],
    ["Covalent radius", rankOf(el, function (e) { return e.r; })]
  ];

  details.innerHTML =
    '<div class="details-head">' +
      '<div class="big-sym" style="background:' + CATEGORIES[el.c].color + '">' +
        '<span class="num">' + el.n + '</span>' +
        '<span class="sym">' + el.s + '</span>' +
      '</div>' +
      '<div>' +
        '<h2>' + el.name + '</h2>' +
        '<p class="fact">' + el.fact + '</p>' +
      '</div>' +
    '</div>' +
    renderSection("Overview", overview) +
    renderSection("Atomic structure", structure) +
    renderSection("Physical properties", physical) +
    renderSection("Chemical properties", chemical) +
    renderSection("Nuclear", nuclear) +
    renderSection("History", history) +
    renderSection("Rankings", rankings) +
    '<div class="nav">' +
      '<button id="prev"' + (el.n === 1 ? ' disabled' : '') + '>&larr; Previous</button>' +
      '<button id="next"' + (el.n === 118 ? ' disabled' : '') + '>Next &rarr;</button>' +
    '</div>';

  document.getElementById("prev").addEventListener("click", function () { selectElement(el.n - 1); });
  document.getElementById("next").addEventListener("click", function () { selectElement(el.n + 1); });
}

function selectElement(n) {
  state.selected = n;
  updateCells();
  renderDetails();
  showPreview(getSelected());
  if (window.innerWidth < 900) {
    details.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }
}

searchInput.addEventListener("input", function () {
  state.search = searchInput.value;
  updateCells();
});

searchInput.addEventListener("keydown", function (event) {
  if (event.key === "Enter") {
    const matches = ELEMENTS.filter(function (el) { return matchesSearch(el, state.search); });
    if (matches.length > 0) {
      selectElement(matches[0].n);
    }
  }
});

modeSelect.addEventListener("change", function () {
  state.mode = modeSelect.value;
  state.highlight = null;
  updateCells();
  showPreview(getSelected());
});

document.addEventListener("keydown", function (event) {
  if (event.target === searchInput || event.target === modeSelect) {
    return;
  }
  if (event.key === "ArrowRight" && state.selected < 118) {
    selectElement(state.selected + 1);
  } else if (event.key === "ArrowLeft" && state.selected > 1) {
    selectElement(state.selected - 1);
  }
});

buildTable();
updateCells();
showPreview(getSelected());
renderDetails();
</script>

